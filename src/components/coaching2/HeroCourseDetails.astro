---
const courseDetails = [
    {
        title: '6 lectures 🎓',
        description: 'Each hour lecture takes about 1 hour and is conducted live with a coach at a time that works for you.'
    },
    {
        title: '6 practical tasks 💻',
        description: 'Practical projects help you quickly get started with the tool while simulating real-world project scenarios.'
    },
    {
        title: 'Your career 👩🏾‍💻',
        description: "After completing the program, you'll be equipped to work as an Analytics Engineer, as dbt is the industry-standard tool in analytics engineering."
    },
]

---

<div class="bg-yellow-300 py-1 pb-16">
    <section class="max-w-6xl mx-auto px-8 md:px-16">
        <div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {courseDetails.map((data, index) => 
                    <div class="bg-yellow-100 rounded-lg shadow-lg p-8">
                        <h2 class="my-4 text-center">{data.title}</h2>
                        <p class="text-sm list-disc ml-4 text-gray-700">{data.description}</p>
                    </div>
                )}
            </div>
        </div>
    </section>
</div>